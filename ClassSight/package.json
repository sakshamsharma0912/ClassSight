{
  "name": "classsight",
  "version": "4.0.0",
  "private": true,
  "description": "ClassSight: teacher batch insights and private student performance dashboards",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/input.css -o ./static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./assets/input.css -o ./static/css/app.css --watch",
    "test:simulator": "node --test tests/*.test.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
